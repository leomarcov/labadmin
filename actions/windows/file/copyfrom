script_id="$(echo ${BASH_SOURCE[0]} | sed 's\^'"$scripts_path"'/*\\g')"		# Script filename with relative script path

#=== LOAD INFO =====================================================================
if [ "$1" = "--load-scriptinfo" ]; then
	script_desc="Copy files or directory from host to admin"
	script_type="scp"
	script_bg=""
	script_interactive=""
	script_admindeps=""
	script_hostdeps=""
	load_scriptinfo "$script_id" "$script_desc" "$script_type" "$script_bg" "$script_interactive" "$script_admindeps" "$script_hostdeps"
	return

#=== READ PARAMS ===================================================================
elif [ "$1" = "--readparams" ]; then
	# PARAM1: remote path
	read_param "$script_id" 1 "Remote path (file or directory)" "" "."
	# PARAM2: local path
	read_param "$script_id" 2 "Local path (directory)" "" "."
	# PARAM3: remote path: src|dest
	p3="src"
  return
fi


#=== EXEC SCRIPT ===================================================================
