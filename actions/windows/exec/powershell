script_id="$(echo ${BASH_SOURCE[0]} | sed 's\^'"$scripts_path"'/*\\g')"		# Script filename with relative script path

#=== LOAD INFO =====================================================================
if [ "$1" = "--load-scriptinfo" ]; then
	script_desc="Exec Powershell interpreter"
	script_type="ssh"
	script_bg="force win"
	script_admindeps=""
	script_hostdeps=""
	script_interactive="true"
	load_scriptinfo "$script_id" "$script_desc" "$script_type" "$script_bg" "$script_admindeps" "$script_hostdeps" "$script_interactive"
	return

#=== READ PARAMS ===================================================================
elif [ "$1" = "--readparams" ]; then
	return
fi


#=== EXEC SCRIPT ===================================================================

cat <<- 'POWERSHELL'
powershell.exe
POWERSHELL
