script_id="$(echo ${BASH_SOURCE[0]} | sed 's\^'"$scripts_path"'/*\\g')"		# Script filename with relative script path

#=== LOAD INFO =====================================================================
if [ "$1" = "--load-scriptinfo" ]; then
	script_desc="Set hostname"
	script_type="ssh"
	script_bg=""
	script_interactive=""
	script_admindeps=""
	script_hostdeps=""
	load_scriptinfo "$script_id" "$script_desc" "$script_type" "$script_bg" "$script_interactive" "$script_admindeps" "$script_hostdeps"
	return

#=== READ PARAMS ===================================================================
elif [ "$1" = "--readparams" ]; then
	# PARAM1: hostname
	read_param "$script_id" 1 'New hostname (use ${n} for replace for host number)' "" "."
	return
fi


#=== EXEC SCRIPT ===================================================================

cat <<- 'POWERSHELL'
$n = $labadmin_nhost
$hn = $p1

$hn = $hn -replace '\$\{n\}', $n

echo $hn

if ($env:COMPUTERNAME -ne $hn) {
    Rename-Computer -NewName $hn -Force
}
POWERSHELL

