#===============================================================================
#  LOAD LIBS
#===============================================================================
readonly labadmin_path="$(dirname $(readlink -f "${0}"))"                       # LABADMIN script root directory path
readonly lib_path="${labadmin_path}/lib/"                                       # LABADMIN LIB PATH
source "${lib_path}/labadmin_lib-admin"                                         # LABADMIN ADMIN VARIABLES AND FUNCTIONS
source "${lib_path}/labadmin_lib"												# LABADMIN GLOBAL VARIABLES AND FUNCTIONS
source "${lib_path}/labadmin_lib-script"										# LABADMIN SCRIPT MODULE
source "${lib_path}/labadmin_lib-install"										# LABADMIN INSTALL MODULE
	


#=== FUNCTION ==================================================================
#        NAME: help
# DESCRIPTION: Show help and exit
# PARAMETERS: 
#	$1	exit code
#===============================================================================
function help() {
	echo -e "Install and check labadmin dependencies for linux agent
    
  INSTALL 
   ${S_B}$(basename $0)${S_R} [-p ssh_port] [-k ssh_pubkey]

   OPTIONS
     ${S_B}ssh_port${S_R}     SSH port configured for allow access to admin
                  If missing use ${S_B}ssh_port${S_R} in ${S_B}labadmin.conf${S_R} -> If missing use default port: ${S_B}58888${S_R}

     ${S_B}ssh_pubkey${S_R}   SSH public key configured to authenticate admin
                  If missing use ${S_B}ssh_pubkey${S_R} in ${S_B}labadmin.conf${S_R}

  CHECK DEPENDENCIES
   ${S_B}$(basename $0)${S_R} -d ask|autoinstall|noinstall     Only check host dependencies (no install agent)
"

	exit $1
}


#### CHECK PARAMETERS
while getopts ":d:hk:p:" o
do
    case $o in
        d) # -d:dependencies
            dparam=1
            daction="$OPTARG"
            [[ "$daction" != @(ask|autoinstall|noinstall) ]] && labadmin_error "Incorrect check dependence action ${daction}\nSupported actions: ask, autoinstall and noinstall" 1            
            ;;
        p) # -p:port
            pparam=1
            psshport="$OPTARG"
            if ! [ "$psshport" -le 65535 ] &>/dev/null || ! [ "$psshport" -gt 0 ]; then labadmin_error "Incorrect port: $psshport"; fi
            ;;
        k) # -k:publickey
            kparam=1
            ppubkey="$OPTARG"
            ;;
        h)
            help
            ;;
        *)
            labadmin_error "Error parameter" 1
            ;;
    esac
done
exit

#### INSTALL 
if [ ! "$dparam" ]; then
    load_scripts "$scripts_path"
    install_host "$psshport" "$ppubkey"

#### CHECK DEPENDENCIES
else
    load_scripts "$scripts_path"
    check_dependencies "$daction" "scripts_hostdeps"
    echo
fi


